{
  "expo": {
    "name": "One More Day",
    "slug": "one-more-day",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "One More Day",
      "shortName": "One More Day",
      "description": "A free, private companion for anyone fighting an addiction. One day at a time.",
      "themeColor": "#141A3D",
      "backgroundColor": "#141A3D",
      "lang": "en"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "One More Day uses your location only to warn you when you get near a place you marked as risky. Your location never leaves your phone.",
          "locationAlwaysAndWhenInUsePermission": "To warn you near places you marked as risky, even when the app is closed. Your location never leaves your phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-router",
      "expo-font",
      "expo-sharing"
    ],
    "scheme": "onemoreday",
    "backgroundColor": "#141A3D",
    "experiments": {
      "typedRoutes": false
    }
  }
}
